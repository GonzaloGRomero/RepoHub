---
// ContextMenu.astro — right-click context menu for planets
---

<div class="context-menu" id="context-menu" role="menu">
  <button class="ctx-item" id="ctx-edit" role="menuitem">✏️ Editar</button>
  <div class="ctx-divider"></div>
  <button class="ctx-item ctx-danger" id="ctx-delete" role="menuitem">🗑️ Eliminar</button>
</div>

<style>
  .context-menu {
    position: fixed; z-index: 400;
    background: #0d0820;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px; padding: 6px;
    display: none; flex-direction: column; gap: 2px;
    min-width: 155px;
    box-shadow: 0 16px 40px rgba(0,0,0,.65);
    animation: pop-in 0.15s ease;
  }
  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: scale(1); }
  }
  .context-menu.open { display: flex; }
  .ctx-item {
    background: none; border: none; color: var(--text);
    font-family: var(--font-main); font-size: .88rem;
    padding: 10px 14px; text-align: left; cursor: pointer;
    border-radius: 6px; transition: background .15s ease;
  }
  .ctx-item:hover { background: var(--surface-2); }
  .ctx-danger { color: var(--danger); }
  .ctx-danger:hover { background: rgba(255,107,107,.1); }
  .ctx-divider { height: 1px; background: var(--border); margin: 2px 0; }
</style>
