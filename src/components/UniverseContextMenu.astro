---
// UniverseContextMenu.astro — Right-click context menu for systems, planets, moons
---

<div class="context-menu" id="context-menu" role="menu">
  <button class="ctx-item" id="ctx-add-planet-to-system" role="menuitem">🪐 Agregar Planeta</button>
  <button class="ctx-item" id="ctx-add-moon" role="menuitem">🌙 Agregar Luna</button>
  <div class="ctx-divider"></div>
  <button class="ctx-item" id="ctx-edit" role="menuitem">✏️ Editar</button>
  <div class="ctx-divider"></div>
  <button class="ctx-item ctx-danger" id="ctx-delete" role="menuitem">🗑️ Eliminar</button>
</div>

<style>
  .context-menu {
    position: fixed; z-index: 500;
    background: rgba(8,4,22,0.98);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px; padding: 6px;
    display: none; flex-direction: column; gap: 2px;
    min-width: 185px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.75), 0 0 0 1px rgba(255,255,255,0.04);
    backdrop-filter: blur(16px);
    animation: ctx-pop 0.12s ease;
  }
  @keyframes ctx-pop {
    from { opacity: 0; transform: scale(0.92) translateY(-4px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  .context-menu.open { display: flex; }

  .ctx-item {
    background: none; border: none; color: rgba(255,255,255,0.85);
    font-family: 'Outfit', sans-serif; font-size: .88rem;
    padding: 9px 14px; text-align: left; cursor: pointer;
    border-radius: 7px; transition: background .15s ease;
  }
  .ctx-item:hover { background: rgba(255,255,255,0.08); }
  .ctx-danger { color: #ff6b6b; }
  .ctx-danger:hover { background: rgba(255,107,107,0.1); }
  .ctx-divider { height: 1px; background: rgba(255,255,255,0.07); margin: 2px 0; }
</style>
