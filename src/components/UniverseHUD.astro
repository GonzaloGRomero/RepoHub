---
// UniverseHUD.astro — Top bar HUD for Universe Mode
---

<header class="hud" id="hud">
  <div class="hud-left">
    <button class="btn-back hidden" id="btn-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15,18 9,12 15,6"/>
      </svg>
      Universo
    </button>
    <div class="hud-breadcrumb">
      <span class="hud-logo">✦</span>
      <h1 class="hud-title" id="hud-title">Dev Universe</h1>
    </div>
  </div>

  <div class="hud-center">
    <span class="hud-count" id="system-count">0 sistemas</span>
  </div>

  <div class="hud-right">
    <button class="btn-hud btn-add-system" id="btn-add-system">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Nuevo Sistema
    </button>
    <button class="btn-hud btn-add-planet hidden" id="btn-add-planet">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Agregar Planeta
    </button>
  </div>
</header>

<!-- Universe hint overlay (hidden once systems exist) -->
<div class="universe-hint" id="universe-hint">
  <div class="hint-content">
    <p class="hint-icon">🌌</p>
    <h2>Tu universo está vacío</h2>
    <p>Creá tu primer sistema estelar para comenzar. Cada sistema representa una categoría de proyectos.</p>
    <button class="btn-hud btn-add-system-hint" onclick="document.getElementById('btn-add-system').click()">
      ✦ Crear primer sistema
    </button>
  </div>
</div>

<!-- Navigation tips -->
<div class="nav-tips" id="nav-tips">
  <span>🖱 Arrastrar para panear</span>
  <span>⚲ Scroll para zoom</span>
  <span>Click en sistema para entrar</span>
</div>

<style>
  /* ─── HUD ─── */
  .hud {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(3,1,10,0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 1.5rem; height: 58px; gap: 1rem;
  }

  .hud-left  { display: flex; align-items: center; gap: 12px; min-width: 180px; }
  .hud-center{ flex: 1; display: flex; justify-content: center; }
  .hud-right { display: flex; align-items: center; gap: 10px; min-width: 180px; justify-content: flex-end; }

  .hud-logo { color: #c97aff; font-size: 1.2rem; animation: pulse-logo 3s ease-in-out infinite; }
  @keyframes pulse-logo {
    0%,100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.6; transform: scale(0.88); }
  }

  .hud-breadcrumb { display: flex; align-items: center; gap: 8px; }
  .hud-title {
    font-family: 'Outfit', sans-serif; font-size: 1.1rem; font-weight: 700;
    color: #e8e4f0; letter-spacing: -0.3px;
  }

  .hud-count {
    font-family: 'Space Mono', monospace; font-size: 0.75rem;
    color: rgba(255,255,255,0.4); letter-spacing: 0.5px;
  }

  .btn-back {
    display: flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.75); border-radius: 20px;
    padding: 6px 14px; font-family: 'Outfit', sans-serif; font-size: 0.82rem;
    cursor: pointer; transition: all 0.2s ease;
  }
  .btn-back:hover { background: rgba(255,255,255,0.12); color: #fff; }

  .btn-hud {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 18px;
    background: linear-gradient(135deg, #6020d0, #c97aff);
    border: none; color: #fff; border-radius: 50px;
    font-family: 'Outfit', sans-serif; font-size: 0.84rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s ease;
    box-shadow: 0 0 18px rgba(201,122,255,0.3);
  }
  .btn-hud:hover { transform: translateY(-1px); box-shadow: 0 0 28px rgba(201,122,255,0.55); }

  .btn-add-planet {
    background: linear-gradient(135deg, #1060c0, #40a0ff);
    box-shadow: 0 0 18px rgba(64,160,255,0.3);
  }
  .btn-add-planet:hover { box-shadow: 0 0 28px rgba(64,160,255,0.55); }

  .hidden { display: none !important; }

  /* ─── Universe hint ─── */
  .universe-hint {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
    z-index: 10; text-align: center; pointer-events: none;
    display: none;
  }
  .universe-hint.visible { display: block; pointer-events: all; }
  .hint-content {
    padding: 2.5rem; max-width: 400px;
    background: rgba(8,4,22,0.85);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    backdrop-filter: blur(20px);
    animation: float-hint 4s ease-in-out infinite;
  }
  @keyframes float-hint {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-12px); }
  }
  .hint-icon { font-size: 3rem; margin-bottom: 1rem; }
  .hint-content h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 0.6rem; color: #fff; }
  .hint-content p  { font-size: 0.88rem; color: rgba(255,255,255,0.55); line-height: 1.6; margin-bottom: 1.5rem; }
  .btn-add-system-hint {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #6020d0, #c97aff);
    border: none; color: #fff; border-radius: 50px;
    font-family: 'Outfit', sans-serif; font-size: 0.92rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s ease;
    box-shadow: 0 0 24px rgba(201,122,255,0.4);
  }
  .btn-add-system-hint:hover { transform: translateY(-2px); box-shadow: 0 0 36px rgba(201,122,255,0.6); }

  /* ─── Nav tips ─── */
  .nav-tips {
    position: fixed; bottom: 1.2rem; left: 50%; transform: translateX(-50%);
    z-index: 50; display: flex; gap: 1.5rem;
    background: rgba(3,1,10,0.65); backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 50px; padding: 8px 20px;
    font-family: 'Space Mono', monospace; font-size: 0.68rem;
    color: rgba(255,255,255,0.38); pointer-events: none;
  }
</style>
