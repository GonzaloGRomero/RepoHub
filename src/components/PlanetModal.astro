---
// PlanetModal.astro — Create / Edit a Planet (project) inside a System
---

<div class="modal-overlay" id="planet-modal-overlay" role="dialog" aria-modal="true">
  <div class="modal">
    <button class="modal-close" id="p-modal-close" aria-label="Cerrar">✕</button>
    <h2 class="modal-title" id="planet-modal-title">Agregar Planeta</h2>

    <form id="planet-form" autocomplete="off" novalidate>
      <input type="hidden" id="p-form-id" />
      <input type="hidden" id="p-form-sys-id" />

      <div class="form-group">
        <label for="p-form-name">Nombre del proyecto <span class="req">*</span></label>
        <input type="text" id="p-form-name" placeholder="Mi Portfolio" required maxlength="30" />
      </div>

      <div class="form-group">
        <label for="p-form-url">URL del proyecto <span class="req">*</span></label>
        <input type="url" id="p-form-url" placeholder="https://usuario.github.io/proyecto" required />
        <small>La captura de pantalla se genera automáticamente</small>
      </div>

      <div class="form-group">
        <label for="p-form-desc">Descripción</label>
        <textarea id="p-form-desc" placeholder="Breve descripción..." rows="2" maxlength="150"></textarea>
      </div>

      <div class="form-group">
        <label>Tipo de planeta</label>
        <div class="planet-color-presets" id="planet-color-presets"></div>
      </div>

      <div class="form-group">
        <label>Tamaño</label>
        <div class="size-options">
          <label class="size-opt">
            <input type="radio" name="p-size" value="small" />
            <span class="size-visual size-s"></span>
            <span>Pequeño</span>
          </label>
          <label class="size-opt">
            <input type="radio" name="p-size" value="medium" checked />
            <span class="size-visual size-m"></span>
            <span>Mediano</span>
          </label>
          <label class="size-opt">
            <input type="radio" name="p-size" value="large" />
            <span class="size-visual size-l"></span>
            <span>Grande</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label>
          Radio orbital:
          <span class="orbit-value-badge"><span id="p-orbit-display">130</span> px</span>
        </label>
        <input type="range" id="p-form-orbit" min="80" max="600" step="5" value="130" class="orbit-slider" />
        <div class="orbit-labels">
          <span>☀️ Cerca</span>
          <span>🌌 Lejos</span>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-cancel" id="p-btn-cancel">Cancelar</button>
        <button type="submit" class="btn-save">
          <span id="p-btn-save-text">Agregar Planeta</span>
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed; inset: 0; z-index: 300;
    background: rgba(0,0,0,0.78); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center; padding: 1rem;
    opacity: 0; pointer-events: none; transition: opacity 0.25s ease;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }

  .modal {
    position: relative; background: #0a051a;
    border: 1px solid rgba(64,160,255,0.25); border-radius: 22px;
    padding: 2rem; width: 100%; max-width: 480px; max-height: 90vh; overflow-y: auto;
    transform: translateY(30px) scale(0.95);
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
    box-shadow: 0 40px 100px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04);
  }
  .modal-overlay.open .modal { transform: translateY(0) scale(1); }

  .modal-close {
    position: absolute; top: 1rem; right: 1rem;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5); width: 32px; height: 32px; border-radius: 50%;
    cursor: pointer; font-size: .85rem; display: flex; align-items: center; justify-content: center;
    transition: all .2s ease;
  }
  .modal-close:hover { color: #fff; background: rgba(255,255,255,0.12); }

  .modal-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 1.4rem; padding-right: 2.5rem; color: #fff; }

  .form-group { margin-bottom: 1rem; }
  .form-group label {
    display: block; font-size: .75rem; font-weight: 600;
    color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: .8px; margin-bottom: .4rem;
  }
  .req { color: #40a0ff; }
  .form-group input, .form-group textarea {
    width: 100%; background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;
    padding: 11px 14px; color: #e8e4f0;
    font-family: 'Outfit', sans-serif; font-size: .9rem;
    transition: all .2s ease; outline: none; resize: vertical;
  }
  .form-group input:focus, .form-group textarea:focus {
    border-color: rgba(64,160,255,0.5);
    background: rgba(64,160,255,0.05);
    box-shadow: 0 0 0 3px rgba(64,160,255,0.12);
  }
  .form-group small { display: block; margin-top: 4px; font-size: .72rem; color: rgba(255,255,255,0.35); }

  :global(.planet-color-presets) { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.planet-preset) {
    width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
    border: 3px solid transparent; transition: transform .2s ease; outline: none;
  }
  :global(.planet-preset:hover) { transform: scale(1.2); }
  :global(.planet-preset.selected) { border-color: #fff; box-shadow: 0 0 0 2px rgba(255,255,255,0.4); }

  .size-options { display: flex; gap: 1.2rem; }
  .size-opt {
    display: flex; flex-direction: column; align-items: center;
    gap: 5px; cursor: pointer; font-size: .75rem; color: rgba(255,255,255,0.5);
  }
  .size-opt input[type="radio"] { display: none; }
  .size-visual {
    border-radius: 50%; background: rgba(64,160,255,0.2);
    border: 2px solid rgba(64,160,255,0.3); display: block; transition: all .2s ease;
  }
  .size-s { width: 20px; height: 20px; }
  .size-m { width: 30px; height: 30px; }
  .size-l { width: 42px; height: 42px; }
  .size-opt input:checked ~ .size-visual {
    background: rgba(64,160,255,0.5); border-color: #40a0ff;
    box-shadow: 0 0 12px rgba(64,160,255,0.5);
  }
  .size-opt input:checked ~ span:last-child { color: #fff; }

  .form-actions { display: flex; gap: 10px; margin-top: 1.4rem; }
  .btn-cancel {
    flex: 1; padding: 11px; background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.55);
    border-radius: 10px; font-family: 'Outfit', sans-serif; font-size: .9rem;
    font-weight: 600; cursor: pointer; transition: all .2s ease;
  }
  .btn-cancel:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .btn-save {
    flex: 2; padding: 11px; display: flex; align-items: center; justify-content: center; gap: 8px;
    background: linear-gradient(135deg, #1060c0, #40a0ff);
    border: none; color: #fff; border-radius: 10px;
    font-family: 'Outfit', sans-serif; font-size: .9rem; font-weight: 700;
    cursor: pointer; transition: all .2s ease;
    box-shadow: 0 4px 20px rgba(64,160,255,0.3);
  }
  .btn-save:hover { transform: translateY(-1px); box-shadow: 0 6px 28px rgba(64,160,255,0.5); }

  /* ── Orbit Slider ── */
  .orbit-value-badge {
    display: inline-block;
    background: rgba(64,160,255,0.15);
    border: 1px solid rgba(64,160,255,0.3);
    border-radius: 20px;
    padding: 1px 10px;
    font-size: .78rem;
    color: rgba(64,160,255,0.9);
    font-family: 'Space Mono', monospace;
    margin-left: 8px;
    font-weight: 700;
    letter-spacing: .5px;
    vertical-align: middle;
  }

  .orbit-slider {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg,
      rgba(64,160,255,0.7),
      rgba(64,160,255,0.2) 60%,
      rgba(255,255,255,0.1));
    outline: none;
    cursor: pointer;
    margin: 8px 0 4px;
  }
  .orbit-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #a0d4ff, #40a0ff);
    border: 2px solid rgba(255,255,255,0.4);
    box-shadow: 0 0 10px rgba(64,160,255,0.7);
    cursor: pointer;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .orbit-slider::-webkit-slider-thumb:hover {
    box-shadow: 0 0 18px rgba(64,160,255,1);
    transform: scale(1.15);
  }
  .orbit-slider::-moz-range-thumb {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #40a0ff;
    border: 2px solid rgba(255,255,255,0.4);
    cursor: pointer;
  }

  .orbit-labels {
    display: flex;
    justify-content: space-between;
    font-size: .68rem;
    color: rgba(255,255,255,0.3);
    margin-top: 2px;
    font-family: 'Space Mono', monospace;
  }
</style>
