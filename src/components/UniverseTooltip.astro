---
// UniverseTooltip.astro — Planet hover card with screenshot + URL button + moons list
---

<div class="planet-tooltip" id="planet-tooltip" role="tooltip">
  <div class="tooltip-preview">
    <img id="tooltip-img" src="" alt="Preview del proyecto" />
    <div class="tooltip-skeleton" id="tooltip-skeleton">
      <div class="sk-bar sk-w70"></div>
      <div class="sk-bar sk-w50"></div>
      <div class="sk-bar sk-w60"></div>
    </div>
    <div class="tooltip-no-img" id="tooltip-no-img">Sin preview disponible</div>
  </div>

  <div class="tooltip-body">
    <h3 id="tooltip-name"></h3>
    <p  id="tooltip-desc"></p>

    <div class="tooltip-moons" id="tooltip-moons"></div>

    <button class="tooltip-url-btn" id="tooltip-url-btn">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
      Abrir proyecto
    </button>
  </div>
</div>

<style>
  .planet-tooltip {
    position: fixed; z-index: 200;
    width: 300px;
    background: rgba(6,3,18,0.97);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px; overflow: hidden;
    box-shadow: 0 28px 70px rgba(0,0,0,0.85), 0 0 0 1px rgba(201,122,255,0.12);
    pointer-events: none;
    opacity: 0; transform: translateY(10px) scale(0.95);
    transition: opacity 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(24px);
  }
  .planet-tooltip.visible {
    opacity: 1; transform: translateY(0) scale(1);
    pointer-events: all;
  }

  /* Preview */
  .tooltip-preview {
    width: 100%; height: 155px;
    background: rgba(255,255,255,0.03); position: relative; overflow: hidden;
  }
  .tooltip-preview img {
    width: 100%; height: 100%; object-fit: cover; display: none;
    transition: opacity 0.3s ease;
  }
  .tooltip-preview img.loaded { display: block; }

  .tooltip-skeleton {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: center;
    gap: 10px; padding: 20px;
  }
  .tooltip-skeleton.hidden { display: none; }
  .sk-bar {
    height: 9px; border-radius: 5px;
    background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.04) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  .sk-w70 { width: 70%; }
  .sk-w50 { width: 50%; }
  .sk-w60 { width: 60%; }
  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .tooltip-no-img {
    position: absolute; inset: 0;
    display: none; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.3); font-size: .78rem; font-family: 'Space Mono', monospace;
  }
  .tooltip-no-img.visible { display: flex; }

  /* Body */
  .tooltip-body { padding: 14px 16px 16px; }
  .tooltip-body h3 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 5px; }
  .tooltip-body p  {
    font-size: .8rem; color: rgba(255,255,255,0.5);
    line-height: 1.5; margin-bottom: 10px; min-height: 16px;
  }

  /* Moons list */
  .tooltip-moons {
    display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px;
  }
  .tooltip-moons.hidden { display: none; }
  :global(.tooltip-moon-link) {
    font-size: .72rem; color: rgba(200,210,240,0.8);
    background: rgba(200,210,240,0.08);
    border: 1px solid rgba(200,210,240,0.15);
    border-radius: 20px; padding: 3px 10px;
    text-decoration: none; font-family: 'Space Mono', monospace;
    transition: all 0.2s ease;
  }
  :global(.tooltip-moon-link:hover) {
    background: rgba(200,210,240,0.18); color: #fff;
  }

  /* URL button */
  .tooltip-url-btn {
    width: 100%; padding: 9px 14px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: linear-gradient(135deg, rgba(139,61,255,0.35), rgba(64,160,255,0.25));
    border: 1px solid rgba(139,61,255,0.4);
    color: rgba(255,255,255,0.9); border-radius: 10px;
    font-family: 'Outfit', sans-serif; font-size: .85rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s ease;
  }
  .tooltip-url-btn:hover {
    background: linear-gradient(135deg, rgba(139,61,255,0.55), rgba(64,160,255,0.4));
    color: #fff;
  }
</style>
